{
  "expo": {
    "name": "HabitFlow",
    "slug": "habitflow",
    "version": "1.0.0",
    "description": "Build daily habits and hit your water goal. Tick off habits, log every sip, and keep your streak alive.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "habitflow",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F6FC",
    "primaryColor": "#6D5DF6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.miharytech.habitflow"
    },
    "android": {
      "package": "com.miharytech.habitflow",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#6D5DF6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 180,
          "backgroundColor": "#6D5DF6",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0A0916"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6D5DF6",
          "defaultChannel": "reminders"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8852886945773718~6644207032",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "This identifier is used to show you more relevant ads, which keeps HabitFlow free."
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "ads": {
        "bannerUnitId": "ca-app-pub-8852886945773718/7032501107",
        "interstitialUnitId": "ca-app-pub-8852886945773718/8154011086",
        "rewardedUnitId": "ca-app-pub-8852886945773718/3041285204"
      },
      "privacyPolicyUrl": "https://miharytech.github.io/habitflow/",
      "supportEmail": "miharyjoel@gmail.com",
      "router": {},
      "eas": {
        "projectId": "ad3e0fc6-6efb-4180-94c6-2f2e214c4230"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
