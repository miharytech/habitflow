{
  "expo": {
    "name": "HabitFlow",
    "slug": "habitflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "habitflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.habitflow.app"
    },
    "android": {
      "package": "com.habitflow.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0916",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F766E"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6D5DF6",
          "defaultChannel": "reminders"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8852886945773718~6644207032",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "extra": {
      "ads": {
        "bannerUnitId": "ca-app-pub-8852886945773718~6644207032",
        "interstitialUnitId": "ca-app-pub-8852886945773718~6644207032",
        "rewardedUnitId": "ca-app-pub-8852886945773718~6644207032"
      },
      "router": {},
      "eas": {
        "projectId": "ad3e0fc6-6efb-4180-94c6-2f2e214c4230"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
